    <string name="walkthrough_welcome_title">הלוח העברי שלך</string>
    <string name="walkthrough_welcome_body">תאריכים עבריים, חגים וזמנים, לצד הלוח הלועזי.</string>
    <string name="walkthrough_location_title">זמנים לפי המקום שלך</string>
    <string name="walkthrough_location_body">לפי המיקום שלך, או לפי הערים שחשובות לך. המעבר ביניהן נעשה מהתפריט.</string>
    <string name="walkthrough_days_title">כל יום, שבת וחג</string>
    <string name="walkthrough_days_body">בהקשה על יום מופיעים הזמנים, הפרשה, ספירת העומר והאירועים, ואפשר לבחור אילו זמנים להציג. הדלקת נרות, הבדלה, ימים טובים וצומות מותאמים אוטומטית לארץ או לחו״ל.</string>
    <string name="walkthrough_agenda_title">כל מה שלפניך, ברשימה אחת</string>
    <string name="walkthrough_agenda_body">סדר היום מציג חגים, זמני שבת, ימי הולדת, יארצייט והאירועים שלך, יום אחר יום. פותחים אותו מהתפריט, מחפשים שנה אחורה וקדימה, או קופצים לכל תאריך.</string>
    <string name="walkthrough_events_title">לזכור כל תאריך</string>
    <string name="walkthrough_events_body">ימי הולדת, יארצייט וימי נישואין חוזרים מדי שנה בתאריך העברי, לפי כללי השנה המעוברת והיארצייט. אפשר לשמור ימי הולדת עבריים באנשי הקשר.</string>
    <string name="walkthrough_reminders_title">לא לפספס הדלקת נרות</string>
    <string name="walkthrough_reminders_body">תזכורות להדלקת נרות, לחגים, לצומות, לאירועים שלך ולספירת העומר.</string>
    <string name="walkthrough_calendars_title">כל היומנים שלך יחד</string>
    <string name="walkthrough_calendars_body">היומנים שבחרת בטלפון מוצגים לצד התאריכים העבריים.</string>
    <string name="walkthrough_widgets_title">לבנה במסך הבית</string>
    <string name="walkthrough_widgets_body">ווידג׳טים של היום, החודש והזמנים, אריח בהגדרות המהירות וסמל אפליקציה שמראה את התאריך העברי של היום.</string>
    <string name="walkthrough_appearance_title">בדיוק כמו שנוח לך</string>
    <string name="walkthrough_appearance_body">בהיר או כהה, צבעי Material You וצבעי חג, בעברית או באנגלית.</string>

    <!-- Permission asks -->
    <string name="walkthrough_permission_location">לבנה משתמשת במיקום רק כדי לחשב זמנים בטלפון הזה. בלעדיו היא משתמשת בעיר באזור הזמן שלך.</string>
    <string name="walkthrough_allow_location">שימוש במיקום שלי</string>
    <string name="walkthrough_granted_location">גישה למיקום אושרה</string>
    <string name="walkthrough_permission_contacts">ימי הולדת עבריים נשמרים באיש הקשר עצמו, בשדה משלהם. שום דבר לא יוצא מהמכשיר.</string>
    <string name="walkthrough_allow_contacts">גישה לאנשי הקשר</string>
    <string name="walkthrough_granted_contacts">גישה לאנשי הקשר אושרה</string>
    <string name="walkthrough_permission_notifications">כדי שלבנה תוכל להזכיר, צריך לאשר התראות. בוחרים אילו תזכורות בהגדרות.</string>
    <string name="walkthrough_allow_notifications">אישור התראות</string>
    <string name="walkthrough_granted_notifications">התראות אושרו</string>
    <string name="walkthrough_permission_calendar">לבנה רק קוראת את היומנים שלך ואף פעם לא משנה אותם. שום דבר לא יוצא מהמכשיר. בוחרים אילו יומנים להציג בהגדרות.</string>
    <string name="walkthrough_allow_calendar">גישה ליומנים</string>
    <string name="walkthrough_granted_calendar">גישה ליומנים אושרה</string>
    <string name="walkthrough_permission_denied">לא אושר. כל השאר עובד, ואפשר לאשר מאוחר יותר בהגדרות.</string>

