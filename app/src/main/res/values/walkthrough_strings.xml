    <string name="walkthrough_show_again_summary">A tour of Levana\'s main features</string>

    <string name="walkthrough_welcome_title">Your Hebrew calendar</string>
    <string name="walkthrough_welcome_body">Hebrew dates, holidays and zmanim, side by side with the Gregorian calendar.</string>
    <string name="walkthrough_location_title">Zmanim for where you are</string>
    <string name="walkthrough_location_body">Use your location, or add the cities you care about. Switch between them from the menu.</string>
    <string name="walkthrough_days_title">Every day, Shabbat and holiday</string>
    <string name="walkthrough_days_body">Tap a day for its zmanim, parasha, Omer and events, and choose which zmanim to show. Candle lighting, havdalah, Yom Tov and fasts follow Israel or the Diaspora automatically.</string>
    <string name="walkthrough_events_title">Remember every date</string>
    <string name="walkthrough_events_body">Birthdays, yahrzeits and anniversaries return each year on their Hebrew date, with the right leap-year and yahrzeit rules. Hebrew birthdays can be saved on your contacts.</string>
    <string name="walkthrough_reminders_title">Never miss candle lighting</string>
    <string name="walkthrough_reminders_body">Reminders for candle lighting, holidays, fasts, your events and the Omer.</string>
    <string name="walkthrough_calendars_title">Your calendars together</string>
    <string name="walkthrough_calendars_body">See the phone calendars you choose alongside the Jewish dates.</string>
    <string name="walkthrough_widgets_title">Levana on your home screen</string>
    <string name="walkthrough_widgets_body">Today, Month and Zmanim widgets, a Quick Settings tile, and an app icon that shows today\'s Hebrew date.</string>
    <string name="walkthrough_appearance_title">Make it yours</string>
    <string name="walkthrough_appearance_body">Light or dark, Material You colors and holiday colors, in Hebrew or English.</string>

    <!-- Permission asks -->
    <string name="walkthrough_permission_location">Levana uses your location only to calculate zmanim on this phone. Without it, it uses a city in your time zone.</string>
    <string name="walkthrough_allow_location">Use my location</string>
    <string name="walkthrough_granted_location">Location allowed</string>
    <string name="walkthrough_permission_contacts">Hebrew birthdays are saved on the contact itself, in a field of their own. Nothing leaves your device.</string>
    <string name="walkthrough_allow_contacts">Allow contacts</string>
    <string name="walkthrough_granted_contacts">Contacts allowed</string>
    <string name="walkthrough_permission_notifications">Allow notifications so Levana can remind you. You choose which reminders in Settings.</string>
    <string name="walkthrough_allow_notifications">Allow notifications</string>
    <string name="walkthrough_granted_notifications">Notifications allowed</string>
    <string name="walkthrough_permission_calendar">Levana only reads your calendars and never changes them. Nothing leaves your device. Choose which calendars to show in Settings.</string>
    <string name="walkthrough_allow_calendar">Allow calendars</string>
    <string name="walkthrough_granted_calendar">Calendars allowed</string>
    <string name="walkthrough_permission_denied">Not allowed. Everything else works, and you can allow it later from Settings.</string>

